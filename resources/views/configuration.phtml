        <div class="row mb-3">
            <label class="col-sm-3 col-form-label" for="nearby-radius-<?= $tree->id() ?>"><?= MoreI18N::translate('Nearby-search radius (km)') ?></label>
            <div class="col-sm-3">
                <input class="form-control" id="nearby-radius-<?= $tree->id() ?>" max="100" min="0.1" name="nearby-radius-<?= $tree->id() ?>" step="0.1" type="number" value="<?= e($tree->getPreference($preference, (string) $default_radius_km)) ?>">
            </div>
        </div>
    <?php endforeach ?>
    <div class="row mb-3"><div class="offset-sm-3 col-sm-9"><button class="btn btn-primary" type="submit"><?= view('icons/save') ?> <?= I18N::translate('save') ?></button></div></div>
    <?= csrf_field() ?>
